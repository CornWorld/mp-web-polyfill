{
  "name": "@cornworld/mp-web-runtime",
  "version": "0.1.0",
  "description": "一站式安装器:按 API 粒度把 mp polyfill 家族装到小程序全局,带冲突检测(不覆盖宿主/他库实现,支持 force)与诊断报告",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "sideEffects": false,
  "dependencies": {
    "@cornworld/mp-core": "workspace:*",
    "@cornworld/mp-eventsource": "workspace:*",
    "@cornworld/mp-fetch": "workspace:*",
    "@cornworld/mp-storage": "workspace:*",
    "@cornworld/mp-text-encoding": "workspace:*",
    "@cornworld/mp-url": "workspace:*",
    "web-streams-polyfill": "^4.1.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --target es2020 --clean --sourcemap"
  },
  "devDependencies": {
    "tsup": "^8.5.0"
  },
  "license": "MIT"
}
