{
  "name": "mp-web-polyfill",
  "version": "0.1.0",
  "description": "微信小程序逻辑层 Web API polyfill 家族:URL / TextEncoder / TextDecoder / localStorage / fetch 家族 / EventSource,附一站式全局安装器(installer 子路径)",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./text-encoding": {
      "types": "./dist/text-encoding/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./url": {
      "types": "./dist/url/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./url/idna": {
      "types": "./dist/url/idna.d.ts",
      "import": "./dist/idna.js",
      "require": "./dist/idna.cjs"
    },
    "./streams/full": {
      "types": "./dist/fetch/streams-full.d.ts",
      "import": "./dist/streams-full.js",
      "require": "./dist/streams-full.cjs"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./fetch": {
      "types": "./dist/fetch/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./fetch/abort": {
      "types": "./dist/fetch/abort.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./fetch/form-data": {
      "types": "./dist/fetch/form-data.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./fetch/streams": {
      "types": "./dist/fetch/streams.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./eventsource": {
      "types": "./dist/eventsource/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./installer": {
      "types": "./dist/installer/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/idna.js",
    "./dist/idna.cjs",
    "./dist/streams-full.js",
    "./dist/streams-full.cjs"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CornWorld/mp-web-polyfill.git"
  },
  "keywords": [
    "weapp",
    "miniprogram",
    "polyfill",
    "fetch",
    "eventsource",
    "url",
    "localstorage"
  ],
  "license": "LGPL-3.0-only",
  "dependencies": {
    "eventsource-parser": "^4.1.1",
    "tr46": "^5.1.1",
    "web-streams-polyfill": "^4.1.0"
  },
  "devDependencies": {
    "tsup": "^8.5.0"
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsup && tsc -b --force"
  }
}
