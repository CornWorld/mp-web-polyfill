{
  "name": "@cornworld/mp-fetch",
  "version": "0.1.0",
  "description": "WHATWG fetch / Request / Response / Headers / AbortController / FormData / Blob 小程序 polyfill,底层桥接 wx.request(支持 enableChunked 流式)",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./abort": {
      "types": "./dist/abort.d.ts",
      "import": "./dist/abort.js",
      "require": "./dist/abort.cjs"
    },
    "./form-data": {
      "types": "./dist/form-data.d.ts",
      "import": "./dist/form-data.js",
      "require": "./dist/form-data.cjs"
    },
    "./streams": {
      "types": "./dist/streams.d.ts",
      "import": "./dist/streams.js",
      "require": "./dist/streams.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "dependencies": {
    "@cornworld/mp-core": "workspace:*",
    "@cornworld/mp-text-encoding": "workspace:*",
    "@cornworld/mp-url": "workspace:*"
  },
  "peerDependencies": {
    "web-streams-polyfill": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "web-streams-polyfill": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/abort.ts src/form-data.ts src/streams.ts --format esm,cjs --target es2020 --clean --sourcemap && tsc -b --force"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "web-streams-polyfill": "^4.1.0"
  },
  "license": "MIT"
}
