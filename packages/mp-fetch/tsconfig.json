{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src",
    "paths": {
      "@cornworld/mp-core": ["../mp-core/src/index.ts"],
      "@cornworld/mp-text-encoding": ["../mp-text-encoding/src/index.ts"],
      "@cornworld/mp-url": ["../mp-url/src/index.ts"]
    }
  },
  "include": ["src"],
  "references": [
    { "path": "../mp-core" },
    { "path": "../mp-text-encoding" },
    { "path": "../mp-url" }
  ]
}
